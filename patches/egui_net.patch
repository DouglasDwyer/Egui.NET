+                    layer_id: inner.layer_id,
+                    id: inner.id,
+                    rect: inner.rect,
+                    interact_rect: inner.interact_rect,
+                    sense: inner.sense,
+                    interact_pointer_pos: inner.interact_pointer_pos,
