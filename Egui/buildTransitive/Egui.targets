<Project>
    <!-- NuGet's RID-asset selection doesn't cover browser-wasm static libraries, so the SDK
         never discovers runtimes/browser-wasm/native on its own; a NativeFileReference is
         required to statically link it into dotnet.native.wasm. WasmBuildNative is set
         explicitly rather than left to the SDK's own NativeFileReference-count auto-detection,
         which isn't reliable across SDK/workload versions. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
        <WasmBuildNative>true</WasmBuildNative>
    </PropertyGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' AND '$(WasmEnableThreads)' == 'true'">
        <NativeFileReference Include="$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native-mt/egui_net.a" />
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' AND '$(WasmEnableThreads)' != 'true'">
        <NativeFileReference Include="$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native/egui_net.a" />
    </ItemGroup>
</Project>
