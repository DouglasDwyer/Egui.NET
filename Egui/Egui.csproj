<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Egui</PackageId>
        <Title>Egui</Title>
        <Description>An easy-to-use immediate mode GUI</Description>
        <Version>0.9.0+0.36.1</Version>
        <Authors>Douglas Dwyer</Authors>
        <RepositoryUrl>https://github.com/DouglasDwyer/Egui.NET</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>1591</NoWarn>
        <Nullable>enable</Nullable>

        <IsAotCompatible>true</IsAotCompatible>

        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">win-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">osx-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">osx-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Linux')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">linux-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Linux')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">linux-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(Configuration)'=='Release'">win-arm64;win-x64;osx-arm64;osx-x64;linux-arm64;linux-x64;browser-wasm</RuntimeIdentifiers>
      </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DouglasDwyer.FixedArray" Version="0.1.1" />
    </ItemGroup>

    <!-- wasm32-unknown-emscripten links via emcc, so building for it needs an Emscripten
         toolchain matching the .NET WebAssembly SDK's own. PackageReference avoids requiring
         the wasm-tools workload just to build. Two toolchain versions: 3.1.56 (single-threaded,
         matches the non-experimental runtime pack) and 6.0.2 (multithreaded, matches the
         wasm-experimental multithread.browser-wasm pack). -->
    <PropertyGroup Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))">
        <_WasmHostRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</_WasmHostRid>
        <_WasmHostRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_WasmHostRid>
        <_WasmHostRid Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">osx-arm64</_WasmHostRid>
        <_WasmHostRid Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">osx-x64</_WasmHostRid>
    </PropertyGroup>

    <ItemGroup Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))">
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Sdk.$(_WasmHostRid)" Version="10.0.10" PrivateAssets="All" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Node.$(_WasmHostRid)" Version="10.0.10" PrivateAssets="All" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Cache.$(_WasmHostRid)" Version="10.0.10" PrivateAssets="All" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.6.0.2.Sdk.$(_WasmHostRid)" Version="11.0.0-preview.7.26381.103" PrivateAssets="All" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.6.0.2.Node.$(_WasmHostRid)" Version="11.0.0-preview.7.26381.103" PrivateAssets="All" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.6.0.2.Cache.$(_WasmHostRid)" Version="11.0.0-preview.7.26381.103" PrivateAssets="All" />
    </ItemGroup>

    <PropertyGroup Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))">
        <_Emscripten>$(NuGetPackageRoot)microsoft.net.runtime.emscripten.3.1.56</_Emscripten>
        <_EmscriptenMt>$(NuGetPackageRoot)microsoft.net.runtime.emscripten.6.0.2</_EmscriptenMt>
        <_EmscriptenSdk>$(_Emscripten).sdk.$(_WasmHostRid)/10.0.10/tools</_EmscriptenSdk>
        <_EmscriptenSdkMt>$(_EmscriptenMt).sdk.$(_WasmHostRid)/11.0.0-preview.7.26381.103/tools</_EmscriptenSdkMt>
        <_EmscriptenNode>$(_Emscripten).node.$(_WasmHostRid)/10.0.10/tools/bin</_EmscriptenNode>
        <_EmscriptenNodeMt>$(_EmscriptenMt).node.$(_WasmHostRid)/11.0.0-preview.7.26381.103/tools/bin</_EmscriptenNodeMt>
        <_EmscriptenCache>$(_Emscripten).cache.$(_WasmHostRid)/10.0.10/tools/emscripten/cache</_EmscriptenCache>
        <_EmscriptenCacheMt>$(_EmscriptenMt).cache.$(_WasmHostRid)/11.0.0-preview.7.26381.103/tools/emscripten/cache</_EmscriptenCacheMt>

        <WasmCargoVariables>PATH=$(_EmscriptenSdk)/bin$([System.IO.Path]::PathSeparator)$(_EmscriptenSdk)/emscripten$([System.IO.Path]::PathSeparator)$(_EmscriptenNode)$([System.IO.Path]::PathSeparator)$(PATH);DOTNET_EMSCRIPTEN_LLVM_ROOT=$(_EmscriptenSdk)/bin;DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(_EmscriptenSdk);DOTNET_EMSCRIPTEN_NODE_JS=$(_EmscriptenNode)/node;EM_CACHE=$(_EmscriptenCache);EM_FROZEN_CACHE=1;PYTHONUTF8=1;EM_WORKAROUND_PYTHON_BUG_34780=1;CARGO_TARGET_WASM32_UNKNOWN_EMSCRIPTEN_LINKER=emcc;CC_wasm32_unknown_emscripten=emcc;AR_wasm32_unknown_emscripten=emar</WasmCargoVariables>
        <!-- The multithreaded runtime pack links with the new (non-legacy) wasm exception-handling
             encoding; -wasm-use-legacy-eh=false on both the C and Rust sides matches that (the
             default LLVM lowering otherwise mixes the two encodings within the same module, which
             the linker rejects), keeping normal panic=unwind so catch_unwind at the FFI boundary
             (egui_invoke) still works. -->
        <WasmCargoVariablesMt>PATH=$(_EmscriptenSdkMt)/bin$([System.IO.Path]::PathSeparator)$(_EmscriptenSdkMt)/emscripten$([System.IO.Path]::PathSeparator)$(_EmscriptenNodeMt)$([System.IO.Path]::PathSeparator)$(PATH);DOTNET_EMSCRIPTEN_LLVM_ROOT=$(_EmscriptenSdkMt)/bin;DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(_EmscriptenSdkMt);DOTNET_EMSCRIPTEN_NODE_JS=$(_EmscriptenNodeMt)/node;EM_CACHE=$(_EmscriptenCacheMt);EM_FROZEN_CACHE=1;PYTHONUTF8=1;EM_WORKAROUND_PYTHON_BUG_34780=1;CARGO_TARGET_WASM32_UNKNOWN_EMSCRIPTEN_LINKER=emcc;CC_wasm32_unknown_emscripten=emcc;AR_wasm32_unknown_emscripten=emar;CFLAGS_wasm32_unknown_emscripten=-matomics -mbulk-memory -fwasm-exceptions -mllvm -wasm-use-legacy-eh=false;RUSTFLAGS=-C target-feature=+atomics,+bulk-memory,+mutable-globals -C llvm-args=-wasm-use-legacy-eh=false</WasmCargoVariablesMt>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Egui.SourceGenerators/Egui.SourceGenerators.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <CargoExecutable Condition="'$(Configuration)'=='Debug'">cargo</CargoExecutable>
        <CargoExecutable Condition="'$(Configuration)'=='Release'">cross</CargoExecutable>

        <CargoProfile Condition="'$(Configuration)'=='Debug'">dev</CargoProfile>
        <CargoProfile Condition="'$(Configuration)'=='Release'">release</CargoProfile>
        
        <CargoFeatures Condition="'$(Configuration)'=='Debug'"></CargoFeatures>
        <CargoFeatures Condition="'$(Configuration)'=='Release'"></CargoFeatures>

        <CargoUnstableOptions Condition="'$(Configuration)'=='Debug'"></CargoUnstableOptions>
        <CargoUnstableOptions Condition="'$(Configuration)'=='Release'"></CargoUnstableOptions>

        <CargoProfileOutput Condition="'$(Configuration)'=='Debug'">debug</CargoProfileOutput>
        <CargoProfileOutput Condition="'$(Configuration)'=='Release'">release</CargoProfileOutput>

        <CargoVariables Condition="'$(Configuration)'=='Debug'"></CargoVariables>
        <CargoVariables Condition="'$(Configuration)'=='Release'">CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=rust-lld;CARGO_TARGET_AARCH64_PC_WINDOWS_MSVC_LINKER=rust-lld</CargoVariables>
    </PropertyGroup>

    <Target Name="BuildNativeLibrary" BeforeTargets="CoreCompile">
        <ItemGroup>
            <RIDList Include="$(RuntimeIdentifiers)" />
        </ItemGroup>

        <ItemGroup>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'win-arm64'">
                <Properties>CargoTarget=aarch64-pc-windows-msvc</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'win-x64'">
                <Properties>CargoTarget=x86_64-pc-windows-msvc</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'osx-arm64'">
                <Properties>CargoTarget=aarch64-apple-darwin</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'osx-x64'">
                <Properties>CargoTarget=x86_64-apple-darwin</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'linux-arm64'">
                <Properties>CargoTarget=aarch64-unknown-linux-gnu</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'linux-x64'">
                <Properties>CargoTarget=x86_64-unknown-linux-gnu</Properties>
            </CargoBuild>
            <!-- No cross image exists for wasm, so these use plain cargo. cargo rustc overrides
                 the crate type to staticlib; the multithreaded build also rebuilds std with
                 atomics via -Zbuild-std, since the prebuilt std lacks it. -->
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'browser-wasm'">
                <Properties>CargoTarget=wasm32-unknown-emscripten;CargoExecutable=cargo;CargoCommand=rustc;CargoExtraOptions=--package egui_net --crate-type staticlib</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'browser-wasm'">
                <Properties>CargoTarget=wasm32-unknown-emscripten;CargoExecutable=cargo;CargoCommand=rustc;CargoWasmThreads=true;CargoUnstableOptions=-Zbuild-std=std,panic_unwind;CargoExtraOptions=--package egui_net --crate-type staticlib --target-dir target-mt</Properties>
            </CargoBuild>
        </ItemGroup>

        <MSBuild Projects="@(CargoBuild)" BuildInParallel="true" StopOnFirstFailure="true" Targets="CargoBuild"/>

        <ItemGroup>
            <Compile Include="../target/bindings/**/*.cs" />
        </ItemGroup>
    </Target>

    <Target Name="CargoBuild">
        <PropertyGroup>
            <CargoCommand Condition="'$(CargoCommand)' == ''">build</CargoCommand>
            <!-- Recomputed rather than passed in: MSBuild's Properties metadata can't carry a
                 value containing semicolons (like an env var list), but this target is a fresh
                 evaluation of the same project file, so WasmCargoVariables is available here too. -->
            <CargoVariables Condition="'$(CargoTarget)' == 'wasm32-unknown-emscripten' AND '$(CargoWasmThreads)' != 'true'">$(WasmCargoVariables)</CargoVariables>
            <CargoVariables Condition="'$(CargoWasmThreads)' == 'true'">$(WasmCargoVariablesMt)</CargoVariables>
        </PropertyGroup>
        <Exec Command="$(CargoExecutable) $(CargoCommand) --profile $(CargoProfile) --target $(CargoTarget) $(CargoUnstableOptions) $(CargoFeatures) $(CargoExtraOptions)"
            EnvironmentVariables="$(CargoVariables)"
            WorkingDirectory=".." />
    </Target>
    
    <ItemGroup>
        <None Include="../target/aarch64-pc-windows-msvc/$(CargoProfileOutput)/egui_net.dll"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('win-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/win-arm64/native/egui_net.dll"
            Link="egui_net.dll"/>
        <None Include="../target/x86_64-pc-windows-msvc/$(CargoProfileOutput)/egui_net.dll"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('win-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/win-x64/native/egui_net.dll"
            Link="egui_net.dll"/>
        <None Include="../target/aarch64-apple-darwin/$(CargoProfileOutput)/libegui_net.dylib"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('osx-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/osx-arm64/native/libegui_net.dylib"
            Link="egui_net.dylib"/>
        <None Include="../target/x86_64-apple-darwin/$(CargoProfileOutput)/libegui_net.dylib"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('osx-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/osx-x64/native/libegui_net.dylib"
            Link="egui_net.dylib"/>
        <None Include="../target/aarch64-unknown-linux-gnu/$(CargoProfileOutput)/libegui_net.so"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('linux-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/linux-arm64/native/libegui_net.so"
            Link="egui_net.so"/>
        <None Include="../target/x86_64-unknown-linux-gnu/$(CargoProfileOutput)/libegui_net.so"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('linux-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/linux-x64/native/libegui_net.so"
            Link="egui_net.so"/>
        <!-- Statically linked into consumers' dotnet.native.wasm by buildTransitive/Egui.targets,
             which picks single- or multi-threaded based on WasmEnableThreads. Packed without
             cargo's "lib" prefix: the wasm SDK derives each NativeFileReference's P/Invoke
             module name from the archive's filename, and the bindings declare DllImport("egui_net"). -->
        <None Include="../target/wasm32-unknown-emscripten/$(CargoProfileOutput)/libegui_net.a"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))"
            Pack="true"
            PackagePath="runtimes/browser-wasm/native/egui_net.a"/>
        <!-- Named native-mt, not native/multithread: NuGet auto-copies everything under a
             literal runtimes/{rid}/native/ folder as a generic asset, flattening subdirectories,
             which collided with the archive above once both were named egui_net.a. -->
        <None Include="../target-mt/wasm32-unknown-emscripten/$(CargoProfileOutput)/libegui_net.a"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))"
            Pack="true"
            PackagePath="runtimes/browser-wasm/native-mt/egui_net.a"/>
        <None Include="buildTransitive/Egui.targets" Pack="true" PackagePath="buildTransitive/Egui.targets"/>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../serde-generate/runtime/csharp/Bincode/*.cs" />
        <Compile Include="../serde-generate/runtime/csharp/Serde/*.cs" />
    </ItemGroup>
</Project>
