<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Egui</PackageId>
        <Title>Egui</Title>
        <Description>An easy-to-use immediate mode GUI</Description>
        <Version>0.9.0+0.36.1</Version>
        <Authors>Douglas Dwyer</Authors>
        <RepositoryUrl>https://github.com/DouglasDwyer/Egui.NET</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>1591</NoWarn>
        <Nullable>enable</Nullable>

        <IsAotCompatible>true</IsAotCompatible>

        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Windows')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">win-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">osx-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">osx-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Linux')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">linux-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('Linux')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">linux-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(Configuration)'=='Release'">win-arm64;win-x64;osx-arm64;osx-x64;linux-arm64;linux-x64;browser-wasm</RuntimeIdentifiers>
      </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DouglasDwyer.FixedArray" Version="0.1.1" />
    </ItemGroup>

    <!-- The wasm32-unknown-emscripten Rust target links via emcc, so building for it needs
         the same Emscripten toolchain the .NET WebAssembly SDK uses. PackageReference (rather
         than requiring the wasm-tools workload) makes this reproducible from a plain restore. -->
    <ItemGroup Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))">
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Sdk.win-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Node.win-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Cache.win-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Sdk.osx-arm64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Node.osx-arm64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Cache.osx-arm64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Sdk.osx-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Node.osx-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Cache.osx-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Sdk.linux-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Node.linux-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <PackageReference Include="Microsoft.NET.Runtime.Emscripten.3.1.56.Cache.linux-x64" Version="10.0.10" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    </ItemGroup>

    <PropertyGroup Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))">
        <_EmscriptenSdkPkg Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Sdk_win-x64)</_EmscriptenSdkPkg>
        <_EmscriptenNodePkg Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Node_win-x64)</_EmscriptenNodePkg>
        <_EmscriptenCachePkg Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Cache_win-x64)</_EmscriptenCachePkg>
        <_EmscriptenSdkPkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Sdk_osx-arm64)</_EmscriptenSdkPkg>
        <_EmscriptenNodePkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Node_osx-arm64)</_EmscriptenNodePkg>
        <_EmscriptenCachePkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'Arm64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Cache_osx-arm64)</_EmscriptenCachePkg>
        <_EmscriptenSdkPkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Sdk_osx-x64)</_EmscriptenSdkPkg>
        <_EmscriptenNodePkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Node_osx-x64)</_EmscriptenNodePkg>
        <_EmscriptenCachePkg Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) == 'x64'">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Cache_osx-x64)</_EmscriptenCachePkg>
        <_EmscriptenSdkPkg Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Sdk_linux-x64)</_EmscriptenSdkPkg>
        <_EmscriptenNodePkg Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Node_linux-x64)</_EmscriptenNodePkg>
        <_EmscriptenCachePkg Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(PkgMicrosoft_NET_Runtime_Emscripten_3_1_56_Cache_linux-x64)</_EmscriptenCachePkg>

        <_EmscriptenBinPath>$(_EmscriptenSdkPkg)/tools/bin</_EmscriptenBinPath>
        <_EmscriptenEmscriptenPath>$(_EmscriptenSdkPkg)/tools/emscripten</_EmscriptenEmscriptenPath>
        <_EmscriptenNodeBinPath>$(_EmscriptenNodePkg)/tools/bin</_EmscriptenNodeBinPath>
        <_EmscriptenCacheDir>$(_EmscriptenCachePkg)/tools/emscripten/cache</_EmscriptenCacheDir>

        <_EmscriptenPathPrepend>$(_EmscriptenBinPath)$([System.IO.Path]::PathSeparator)$(_EmscriptenEmscriptenPath)$([System.IO.Path]::PathSeparator)$(_EmscriptenNodeBinPath)$([System.IO.Path]::PathSeparator)</_EmscriptenPathPrepend>

        <WasmCargoVariables>PATH=$(_EmscriptenPathPrepend)$(PATH);DOTNET_EMSCRIPTEN_LLVM_ROOT=$(_EmscriptenBinPath);DOTNET_EMSCRIPTEN_BINARYEN_ROOT=$(_EmscriptenSdkPkg)/tools;DOTNET_EMSCRIPTEN_NODE_JS=$(_EmscriptenNodeBinPath)/node;EM_CACHE=$(_EmscriptenCacheDir);EM_FROZEN_CACHE=1;PYTHONUTF8=1;EM_WORKAROUND_PYTHON_BUG_34780=1;CARGO_TARGET_WASM32_UNKNOWN_EMSCRIPTEN_LINKER=emcc;CC_wasm32_unknown_emscripten=emcc;AR_wasm32_unknown_emscripten=emar</WasmCargoVariables>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Egui.SourceGenerators/Egui.SourceGenerators.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false" />
    </ItemGroup>

    <PropertyGroup>
        <CargoExecutable Condition="'$(Configuration)'=='Debug'">cargo</CargoExecutable>
        <CargoExecutable Condition="'$(Configuration)'=='Release'">cross</CargoExecutable>

        <CargoProfile Condition="'$(Configuration)'=='Debug'">dev</CargoProfile>
        <CargoProfile Condition="'$(Configuration)'=='Release'">release</CargoProfile>
        
        <CargoFeatures Condition="'$(Configuration)'=='Debug'"></CargoFeatures>
        <CargoFeatures Condition="'$(Configuration)'=='Release'"></CargoFeatures>

        <CargoUnstableOptions Condition="'$(Configuration)'=='Debug'"></CargoUnstableOptions>
        <CargoUnstableOptions Condition="'$(Configuration)'=='Release'"></CargoUnstableOptions>

        <CargoProfileOutput Condition="'$(Configuration)'=='Debug'">debug</CargoProfileOutput>
        <CargoProfileOutput Condition="'$(Configuration)'=='Release'">release</CargoProfileOutput>

        <CargoVariables Condition="'$(Configuration)'=='Debug'"></CargoVariables>
        <CargoVariables Condition="'$(Configuration)'=='Release'">CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=rust-lld;CARGO_TARGET_AARCH64_PC_WINDOWS_MSVC_LINKER=rust-lld</CargoVariables>
    </PropertyGroup>

    <Target Name="BuildNativeLibrary" BeforeTargets="CoreCompile">
        <ItemGroup>
            <RIDList Include="$(RuntimeIdentifiers)" />
        </ItemGroup>

        <ItemGroup>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'win-arm64'">
                <Properties>CargoTarget=aarch64-pc-windows-msvc</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'win-x64'">
                <Properties>CargoTarget=x86_64-pc-windows-msvc</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'osx-arm64'">
                <Properties>CargoTarget=aarch64-apple-darwin</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'osx-x64'">
                <Properties>CargoTarget=x86_64-apple-darwin</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'linux-arm64'">
                <Properties>CargoTarget=aarch64-unknown-linux-gnu</Properties>
            </CargoBuild>
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'linux-x64'">
                <Properties>CargoTarget=x86_64-unknown-linux-gnu</Properties>
            </CargoBuild>
            <!-- Uses plain cargo (no cross image exists for wasm) and cargo rustc, which can
                 override the crate type to staticlib for just this target. -->
            <CargoBuild Include="$(MSBuildProjectFile)" Condition="'%(RIDList.Identity)' == 'browser-wasm'">
                <Properties>CargoTarget=wasm32-unknown-emscripten;CargoExecutable=cargo;CargoCommand=rustc;CargoExtraOptions=--package egui_net --crate-type staticlib</Properties>
            </CargoBuild>
        </ItemGroup>

        <MSBuild Projects="@(CargoBuild)" BuildInParallel="true" StopOnFirstFailure="true" Targets="CargoBuild"/>

        <ItemGroup>
            <Compile Include="../target/bindings/**/*.cs" />
        </ItemGroup>
    </Target>

    <Target Name="CargoBuild">
        <PropertyGroup>
            <CargoCommand Condition="'$(CargoCommand)' == ''">build</CargoCommand>
            <!-- Recomputed here rather than passed in from BuildNativeLibrary: this target
                 runs as a fresh evaluation of this same project file (nested MSBuild call), so
                 WasmCargoVariables is already available, and MSBuild global-property passing
                 can't carry a value containing semicolons through anyway. -->
            <CargoVariables Condition="'$(CargoTarget)' == 'wasm32-unknown-emscripten'">$(WasmCargoVariables)</CargoVariables>
        </PropertyGroup>
        <Exec Command="$(CargoExecutable) $(CargoCommand) --profile $(CargoProfile) --target $(CargoTarget) $(CargoUnstableOptions) $(CargoFeatures) $(CargoExtraOptions)"
            EnvironmentVariables="$(CargoVariables)"
            WorkingDirectory=".." />
    </Target>
    
    <ItemGroup>
        <None Include="../target/aarch64-pc-windows-msvc/$(CargoProfileOutput)/egui_net.dll"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('win-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/win-arm64/native/egui_net.dll"
            Link="egui_net.dll"/>
        <None Include="../target/x86_64-pc-windows-msvc/$(CargoProfileOutput)/egui_net.dll"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('win-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/win-x64/native/egui_net.dll"
            Link="egui_net.dll"/>
        <None Include="../target/aarch64-apple-darwin/$(CargoProfileOutput)/libegui_net.dylib"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('osx-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/osx-arm64/native/libegui_net.dylib"
            Link="egui_net.dylib"/>
        <None Include="../target/x86_64-apple-darwin/$(CargoProfileOutput)/libegui_net.dylib"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('osx-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/osx-x64/native/libegui_net.dylib"
            Link="egui_net.dylib"/>
        <None Include="../target/aarch64-unknown-linux-gnu/$(CargoProfileOutput)/libegui_net.so"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('linux-arm64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/linux-arm64/native/libegui_net.so"
            Link="egui_net.so"/>
        <None Include="../target/x86_64-unknown-linux-gnu/$(CargoProfileOutput)/libegui_net.so"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('linux-x64'))"
            Pack="true"
            CopyToOutputDirectory="Always"
            PackagePath="runtimes/linux-x64/native/libegui_net.so"
            Link="egui_net.so"/>
        <!-- Static library for WebAssembly, statically linked into consumers' dotnet.native.wasm
             by buildTransitive/Egui.targets (see that file for why it can't just be discovered
             from this runtimes/ path alone). Not copied to the output directory like the
             dynamic libraries above, since it is never loaded at run time. Packed without the
             "lib" prefix cargo gives it: the wasm SDK derives each NativeFileReference's P/Invoke
             module name from the archive's filename (no "lib"/extension stripping like desktop
             dynamic loading does), and the generated bindings declare DllImport("egui_net"). -->
        <None Include="../target/wasm32-unknown-emscripten/$(CargoProfileOutput)/libegui_net.a"
            Condition="$([System.String]::new('$(RuntimeIdentifiers)').Contains('browser-wasm'))"
            Pack="true"
            PackagePath="runtimes/browser-wasm/native/egui_net.a"/>
        <None Include="buildTransitive/Egui.targets" Pack="true" PackagePath="buildTransitive/Egui.targets"/>
        <None Include="../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../serde-generate/runtime/csharp/Bincode/*.cs" />
        <Compile Include="../serde-generate/runtime/csharp/Serde/*.cs" />
    </ItemGroup>
</Project>
