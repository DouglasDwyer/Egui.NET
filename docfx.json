{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "Egui/*.csproj",
            "Egui.*/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Debug"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "media/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Egui.NET",
      "_appTitle": "Egui.NET",
      "_enableSearch": true,
      "pdf": false
    }
  }
}