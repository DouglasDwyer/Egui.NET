<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>

    <PackageId>Egui.Silk.NET.OpenGL</PackageId>
    <Title>Egui.Silk.NET.OpenGL</Title>
    <Description>An easy-to-use immediate mode GUI</Description>
    <Version>0.11.0+0.37.0</Version>
    <Authors>Douglas Dwyer</Authors>
    <RepositoryUrl>https://github.com/DouglasDwyer/Egui.NET</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Egui\Egui.csproj" />
    <ProjectReference Include="..\Egui.Silk.NET\Egui.Silk.NET.csproj" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
